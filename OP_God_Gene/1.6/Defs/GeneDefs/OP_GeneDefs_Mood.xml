<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- 기분(Mood)은 StatDef가 아니라 Need라서 statOffsets로는 못 건드린다. 대신 실제
       바닐라에서 쓰이는 확인된 방식(HediffStage.needOffsets)으로 직접 Mood Need를
       거의 최대치로 밀어붙이는 커스텀 히디프를 만들고, 유전자의 hediffDef 필드로
       부여한다(메카링크를 부여했던 것과 동일한 방식). -->
  <HediffDef>
    <defName>OP_MoodPumpHediff</defName>
    <label>기분 펌핑 회로</label>
    <description>뇌의 쾌락 중추를 안전하게 자극해 항상 최상의 기분을 유지하게 하는 신경 회로. 중독성이나 부작용은 없다.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <isBad>false</isBad>
    <stages>
      <li>
        <needOffsets>
          <li>
            <need>Mood</need>
            <offset>0.9</offset>
          </li>
        </needOffsets>
      </li>
    </stages>
  </HediffDef>

  <GeneDef>
    <defName>OP_MoodPump</defName>
    <label>기분 펌핑</label>
    <description>뇌에 안전한 쾌락 자극 회로를 심어 항상 최상의 기분을 유지하게 하는 유전자. 정신붕괴 걱정 없이 무슨 일이 있어도 행복하다.</description>
    <iconPath>UI/Icons/Genes/Gene_Deathless</iconPath>
    <displayCategory>Miscellaneous</displayCategory>
    <biostatCpx>2</biostatCpx>
    <biostatMet>0</biostatMet>
    <biostatArc>0</biostatArc>
    <selectionWeight>0</selectionWeight>
    <displayOrderInCategory>40</displayOrderInCategory>

    <hediffDef>OP_MoodPumpHediff</hediffDef>

    <statOffsets>
      <MentalBreakThreshold>-0.5</MentalBreakThreshold>
    </statOffsets>
  </GeneDef>

  <!-- 매력 펌핑: PawnBeauty(외모)와 사교 관련 스탯을 전담으로 크게 올려주는 유전자.
       초월자 유전자에도 PawnBeauty +80이 있지만, 이건 매력 자체에 특화된 전용 유전자. -->
  <GeneDef>
    <defName>OP_CharmPump</defName>
    <label>매력 펌핑</label>
    <description>페로몬과 표정근, 목소리 톤까지 전부 최적화해 누구에게나 매력적으로 보이게 만드는 유전자.</description>
    <iconPath>UI/Icons/Genes/Gene_Deathless</iconPath>
    <displayCategory>Miscellaneous</displayCategory>
    <biostatCpx>2</biostatCpx>
    <biostatMet>0</biostatMet>
    <biostatArc>0</biostatArc>
    <selectionWeight>0</selectionWeight>
    <displayOrderInCategory>41</displayOrderInCategory>

    <statOffsets>
      <PawnBeauty>200</PawnBeauty>
      <SocialImpact>5</SocialImpact>
      <NegotiationAbility>10</NegotiationAbility>
    </statOffsets>

    <statFactors>
      <SocialImpact>3</SocialImpact>
    </statFactors>
  </GeneDef>

</Defs>
