<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- ===================== 초월 소총 1/2단계 (하위/중간 티어) =====================
       기존 OP_TranscendentRifle(3단계, 극한치)보다 낮은 등급.
       1단계: 지금까지 분석한 다른 모드들(밀리라, Chaoura 등)과 비슷하거나 살짝 위 수준
       2단계: 1단계와 3단계 사이 중간 다리 -->

  <ThingDef>
    <defName>OP_Bullet_TierA</defName>
    <label>초월탄 (1단계)</label>
    <thingClass>Bullet</thingClass>
    <category>Projectile</category>
    <tickerType>Normal</tickerType>
    <altitudeLayer>Projectile</altitudeLayer>
    <useHitPoints>false</useHitPoints>
    <neverMultiSelect>true</neverMultiSelect>
    <graphicData>
      <texPath>Things/Projectile/Bullet_Small</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <shaderType>TransparentPostLight</shaderType>
      <drawSize>0.6</drawSize>
      <color>(120,180,255)</color>
    </graphicData>
    <projectile>
      <damageDef>Bomb</damageDef>
      <damageAmountBase>80</damageAmountBase>
      <armorPenetrationBase>10</armorPenetrationBase>
      <stoppingPower>2</stoppingPower>
      <speed>80</speed>
    </projectile>
  </ThingDef>

  <ThingDef>
    <defName>OP_Bullet_TierB</defName>
    <label>초월탄 (2단계)</label>
    <thingClass>Bullet</thingClass>
    <category>Projectile</category>
    <tickerType>Normal</tickerType>
    <altitudeLayer>Projectile</altitudeLayer>
    <useHitPoints>false</useHitPoints>
    <neverMultiSelect>true</neverMultiSelect>
    <graphicData>
      <texPath>Things/Projectile/Bullet_Small</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <shaderType>TransparentPostLight</shaderType>
      <drawSize>0.6</drawSize>
      <color>(180,120,255)</color>
    </graphicData>
    <projectile>
      <damageDef>Bomb</damageDef>
      <damageAmountBase>3000</damageAmountBase>
      <armorPenetrationBase>2000</armorPenetrationBase>
      <stoppingPower>10</stoppingPower>
      <speed>150</speed>
    </projectile>
  </ThingDef>

  <ThingDef>
    <defName>OP_TranscendentRifle_TierA</defName>
    <label>초월 소총 (1단계)</label>
    <description>초월 소총의 초기 각성 단계. 다른 모드의 최상급 장비와 비슷하거나 살짝 웃도는 수준.</description>
    <thingClass>ThingWithComps</thingClass>
    <category>Item</category>
    <techLevel>Spacer</techLevel>
    <tradeability>None</tradeability>
    <useHitPoints>true</useHitPoints>
    <selectable>true</selectable>
    <altitudeLayer>Item</altitudeLayer>
    <equipmentType>Primary</equipmentType>
    <comps>
      <li>
        <compClass>CompEquippable</compClass>
      </li>
    </comps>
    <pathCost>15</pathCost>
    <rotatable>false</rotatable>
    <drawerType>MapMeshAndRealTime</drawerType>
    <alwaysHaulable>true</alwaysHaulable>
    <graphicData>
      <texPath>Things/Item/Equipment/WeaponRanged/AssaultRifle</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <color>(120,180,255)</color>
    </graphicData>
    <soundInteract>Interact_Rifle</soundInteract>
    <thingCategories>
      <li>Weapons</li>
    </thingCategories>
    <weaponTags>
      <li>OP_Weapon</li>
    </weaponTags>
    <statBases>
      <WorkToMake>4000</WorkToMake>
      <Mass>3</Mass>
      <MaxHitPoints>300</MaxHitPoints>
      <AccuracyTouch>0.9</AccuracyTouch>
      <AccuracyShort>0.95</AccuracyShort>
      <AccuracyMedium>0.9</AccuracyMedium>
      <AccuracyLong>0.85</AccuracyLong>
      <RangedWeapon_Cooldown>0.8</RangedWeapon_Cooldown>
      <ShootingAccuracyPawn>1.3</ShootingAccuracyPawn>
    </statBases>
    <tools>
      <li>
        <label>총열 강타 (1단계)</label>
        <capacities><li>Blunt</li></capacities>
        <power>40</power>
        <cooldownTime>0.5</cooldownTime>
        <armorPenetration>8</armorPenetration>
      </li>
    </tools>
    <verbs>
      <li>
        <verbClass>Verb_Shoot</verbClass>
        <hasStandardCommand>true</hasStandardCommand>
        <defaultProjectile>OP_Bullet_TierA</defaultProjectile>
        <warmupTime>0.8</warmupTime>
        <range>35</range>
        <burstShotCount>3</burstShotCount>
        <soundCast>Shot_AssaultRifle</soundCast>
        <soundCastTail>GunTail_Light</soundCastTail>
        <muzzleFlashScale>9</muzzleFlashScale>
      </li>
    </verbs>
  </ThingDef>

  <ThingDef>
    <defName>OP_TranscendentRifle_TierB</defName>
    <label>초월 소총 (2단계)</label>
    <description>1단계와 완성형(3단계) 사이의 중간 진화 단계.</description>
    <thingClass>ThingWithComps</thingClass>
    <category>Item</category>
    <techLevel>Ultra</techLevel>
    <tradeability>None</tradeability>
    <useHitPoints>true</useHitPoints>
    <selectable>true</selectable>
    <altitudeLayer>Item</altitudeLayer>
    <equipmentType>Primary</equipmentType>
    <comps>
      <li>
        <compClass>CompEquippable</compClass>
      </li>
    </comps>
    <pathCost>15</pathCost>
    <rotatable>false</rotatable>
    <drawerType>MapMeshAndRealTime</drawerType>
    <alwaysHaulable>true</alwaysHaulable>
    <graphicData>
      <texPath>Things/Item/Equipment/WeaponRanged/AssaultRifle</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <color>(180,120,255)</color>
    </graphicData>
    <soundInteract>Interact_Rifle</soundInteract>
    <thingCategories>
      <li>Weapons</li>
    </thingCategories>
    <weaponTags>
      <li>OP_Weapon</li>
    </weaponTags>
    <statBases>
      <WorkToMake>1</WorkToMake>
      <Mass>1.5</Mass>
      <MaxHitPoints>9999</MaxHitPoints>
      <Flammability>0</Flammability>
      <DeteriorationRate>0</DeteriorationRate>
      <AccuracyTouch>3.0</AccuracyTouch>
      <AccuracyShort>3.0</AccuracyShort>
      <AccuracyMedium>3.0</AccuracyMedium>
      <AccuracyLong>3.0</AccuracyLong>
      <RangedWeapon_Cooldown>0.2</RangedWeapon_Cooldown>
      <ShootingAccuracyPawn>3.0</ShootingAccuracyPawn>
    </statBases>
    <tools>
      <li>
        <label>총열 강타 (2단계)</label>
        <capacities><li>Blunt</li></capacities>
        <power>3000</power>
        <cooldownTime>0.1</cooldownTime>
        <armorPenetration>100000</armorPenetration>
      </li>
    </tools>
    <verbs>
      <li>
        <verbClass>Verb_Shoot</verbClass>
        <hasStandardCommand>true</hasStandardCommand>
        <defaultProjectile>OP_Bullet_TierB</defaultProjectile>
        <warmupTime>0.2</warmupTime>
        <range>60</range>
        <burstShotCount>1</burstShotCount>
        <soundCast>Shot_AssaultRifle</soundCast>
        <soundCastTail>GunTail_Light</soundCastTail>
        <muzzleFlashScale>11</muzzleFlashScale>
      </li>
    </verbs>
  </ThingDef>

</Defs>
